<UserControl x:Class="NetworkTelemetryInspector.Views.FirstRunStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
            <TextBlock Text="{Binding Number, ElementName=Root}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail, ElementName=Root}" Style="{StaticResource BodyText}" FontSize="12.5" LineHeight="18" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
