<UserControl x:Class="NetworkTelemetryInspector.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Privacy" Style="{StaticResource TitleText}" />
            <TextBlock Text="Network &amp; Telemetry Inspector does not collect or upload your network activity." FontSize="15" Foreground="{DynamicResource Text2Brush}" Margin="0,6,0,20" TextWrapping="Wrap" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="What stays on this PC" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}">
                        Everything. Connections, hostnames, history, settings and logs are read and stored locally only.
                        There are no user accounts, no cloud backend, no analytics, no advertising and no telemetry from this application.
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                        <Run Text="Local data folder:" /> <Run Text="{Binding Settings.DataFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="The only outbound requests" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Public IP lookup (optional)." />
                        <Run Text="Public IP lookup uses an external service (api.ipify.org). It is a plain HTTPS GET that sends no system or network information. Turn it off in Settings and the request is never made." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Reverse DNS (optional)." />
                        <Run Text="To name an IP address that is not in the local DNS cache, a PTR query can be sent to your own configured DNS server — the same thing Windows does for any name lookup. Turn off 'Reverse DNS lookups' in Settings to rely only on the local DNS cache." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                        <Run Text="Signature checks run fully offline: revocation checking is disabled and certificate retrieval is cache-only." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0">
                        <Run Text="Public IP lookup is currently:" /> <Run Text="{Binding PublicIp, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="What this application can and cannot see" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}">
                        It sees connection metadata that Windows already exposes: the owning process, destination IP address and port, the hostname where the PC looked it up
                        or reverse DNS can name it, the connection state and — when running as administrator — TCP traffic volume.
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                        It does not intercept, capture or decrypt traffic, and it cannot know what an encrypted (HTTPS) connection carries.
                        Labels such as "Possible Telemetry" are heuristic and informational: they are based on hostname and process-name patterns
                        (editable in Settings) and do not prove that a connection transmits telemetry.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Known limitations" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="• Per-application upload/download uses Windows TCP extended statistics, which require administrator rights to enable. As a standard user only machine-wide adapter throughput is shown." />
                    <TextBlock Style="{StaticResource BodyText}" Text="• UDP traffic cannot be attributed to a remote address or measured per process: Windows only reports the local UDP endpoint." />
                    <TextBlock Style="{StaticResource BodyText}" Text="• Connections that open and close between two refreshes may be missed. Lower the refresh interval for finer detail." />
                    <TextBlock Style="{StaticResource BodyText}" Text="• Blocked connection attempts are recognised as a blocked application's connections stuck in SYN_SENT; Windows Firewall's own drop log is not read, because enabling it would change a security setting." />
                    <TextBlock Style="{StaticResource BodyText}" Text="• Protected processes may hide their executable path from a standard user; they are shown as 'Unknown Process' and cannot be blocked." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
