<UserControl x:Class="NetworkTelemetryInspector.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NetworkTelemetryInspector.Controls">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open Windows Firewall" Command="{Binding OpenWindowsFirewallCommand}" Margin="0,0,8,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource DangerButton}" Content="Remove all Network &amp; Telemetry Inspector rules" Command="{Binding RemoveAllCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Firewall" Style="{StaticResource TitleText}" />
                <TextBlock Text="Outbound block rules created by this application in Windows Defender Firewall." Foreground="{DynamicResource Text2Brush}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource LabelText}" FontWeight="SemiBold" />
                    <c:Pill Text="{Binding FirewallState}" Tone="{Binding FirewallTone}" Margin="0,8,0,8" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ElevationNote}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ReadError}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                               Visibility="{Binding ReadError, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="SAFETY" Style="{StaticResource LabelText}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding OwnershipNote}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <DataGrid ItemsSource="{Binding Rules}" RowHeight="46" AutomationProperties.Name="Firewall rules">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="APPLICATION" Width="240" SortMemberPath="Application">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Application}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="{Binding Path}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RULE" Binding="{Binding Name}" Width="*" FontFamily="{StaticResource MonoFont}" />
                        <DataGridTextColumn Header="DIRECTION" Binding="{Binding Direction}" Width="100" />
                        <DataGridTemplateColumn Header="ACTION" Width="90" SortMemberPath="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:Pill Text="{Binding Action}" Tone="Danger" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ENABLED" Width="90" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <c:Pill Text="Yes" Tone="Success" Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}" />
                                        <c:Pill Text="No" Tone="Neutral" Visibility="{Binding Enabled, Converter={StaticResource InvBoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="290" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RowButton}" Content="{Binding ToggleText}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowSuccessButton}" Content="Unblock" Margin="0,0,6,0" ToolTip="Remove every rule of ours for this application"
                                                Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowDangerButton}" Content="Delete"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding RuleCount, Converter={StaticResource ZeroToVis}}">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="No blocked applications" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Use Block on the Dashboard to stop an application from reaching the Internet." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressBar Style="{StaticResource LoadingBar}" VerticalAlignment="Top" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
