<Window x:Class="NetworkTelemetryInspector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NetworkTelemetryInspector.Controls"
        xmlns:v="clr-namespace:NetworkTelemetryInspector.Views"
        xmlns:vm="clr-namespace:NetworkTelemetryInspector.ViewModels"
        Title="Network &amp; Telemetry Inspector" Width="1440" Height="880" MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="/NetworkTelemetryInspector;component/Resources/app.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/NetworkTelemetryInspector;component/Resources/app.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Network &amp; Telemetry Inspector" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="See what your PC is talking to." FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Pill Text="{Binding ModeText}" Tone="{Binding ModeTone}" ToolTip="{Binding ModeTooltip}" Margin="0,0,14,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <c:Pill Text="{Binding NetworkStatus}" Tone="{Binding NetworkTone}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="PRIVATE IP" Style="{StaticResource LabelText}" FontSize="10" />
                        <TextBlock Text="{Binding PrivateIp}" Style="{StaticResource MonoText}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding PublicIpTooltip}" Background="Transparent">
                        <TextBlock Text="PUBLIC IP" Style="{StaticResource LabelText}" FontSize="10" />
                        <TextBlock Text="{Binding PublicIp}" Style="{StaticResource MonoText}" />
                    </StackPanel>
                    <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="4,4,8,4" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding TogglePauseCommand}" ToolTip="{Binding PauseText}" AutomationProperties.Name="Pause or resume monitoring">
                        <Grid>
                            <TextBlock Text="&#xE769;" Visibility="{Binding IsPaused, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Text="&#xE768;" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Refresh now (F5)" AutomationProperties.Name="Refresh" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings" />
                </StackPanel>
            </Grid>
        </Border>
        <ProgressBar Grid.ColumnSpan="2" Style="{StaticResource LoadingBar}" VerticalAlignment="Bottom"
                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />

        <!-- ================= Navigation rail ================= -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Standard user" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Blocking prompts for admin when used. Per-app traffic needs admin." Style="{StaticResource BodyText}" FontSize="11.5" LineHeight="16" Margin="0,3,0,6" />
                            <Button Style="{StaticResource LinkButton}" Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.ReadOnlyMode}" Margin="4,0,4,10" FontSize="12.5"
                              ToolTip="Monitoring only: no firewall rules or system settings are changed.">Read-only mode</CheckBox>
                    <TextBlock Style="{StaticResource LabelText}" Margin="4,0" FontSize="11">
                        <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" /> <Run Text=" · Local only" />
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xEA18;" Content="Firewall" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Firewall}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="History" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE968;" Content="Network" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Network}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE72E;" Content="Privacy" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Privacy}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Row="1" Grid.Column="1">
            <v:DashboardView x:Name="DashboardPage" DataContext="{Binding Dashboard}"
                             Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Dashboard}" />
            <v:FirewallView DataContext="{Binding Firewall}"
                            Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Firewall}" />
            <v:HistoryView DataContext="{Binding History}"
                           Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=History}" />
            <v:NetworkView DataContext="{Binding NetworkInfo}"
                           Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Network}" />
            <v:PrivacyView Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Privacy}" />
            <v:SettingsView DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}" />
        </Grid>

        <!-- ================= Toast ================= -->
        <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8"
                Padding="14,10" MaxWidth="720" Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="4" CornerRadius="2" Margin="0,0,12,0" x:Name="ToastBar">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastTone}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastTone}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastTone}" Value="Danger">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" MaxWidth="620" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Margin="10,0,0,0" Command="{Binding DismissToastCommand}" ToolTip="Dismiss" />
            </StackPanel>
        </Border>

        <!-- ================= First run ================= -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding FirstRunVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28">
                <StackPanel>
                    <Image Source="/NetworkTelemetryInspector;component/Resources/app.ico" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Network &amp; Telemetry Inspector" Style="{StaticResource TitleText}" Margin="0,16,0,2" />
                    <TextBlock Text="See what your PC is talking to." Foreground="{DynamicResource Text2Brush}" FontSize="14" Margin="0,0,0,22" />

                    <v:FirstRunStep Number="1" Title="Detect network adapters" Detail="{Binding FirstRunAdapters}" />
                    <v:FirstRunStep Number="2" Title="Start monitoring" Detail="{Binding FirstRunMonitoring}" />
                    <v:FirstRunStep Number="3" Title="Show current connections" Detail="{Binding FirstRunConnections}" />
                    <v:FirstRunStep Number="4" Title="Blocking needs administrator rights"
                                    Detail="Monitoring runs as a normal user. When you block or unblock an application, Windows asks for administrator permission for that one change." />
                    <v:FirstRunStep Number="5" Title="Everything stays on this PC"
                                    Detail="No accounts, no cloud, no analytics. Your network activity is never uploaded. The only optional outbound request is the public IP lookup, which you can turn off in Settings." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <ProgressBar Style="{StaticResource LoadingBar}" Width="120" Margin="0,0,16,0" VerticalAlignment="Center"
                                     Visibility="{Binding FirstRunReady, Converter={StaticResource InvBoolToVis}}" />
                        <Button Style="{StaticResource AccentButton}" Content="Get started" Padding="22,9" Command="{Binding CompleteFirstRunCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Confirmation dialog ================= -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding DialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource BodyText}" Margin="0,12,0,22" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding DialogCancelCommand}" IsCancel="True" Margin="0,0,10,0" MinWidth="90" />
                        <Button x:Name="DialogConfirmButton" Content="{Binding DialogConfirmText}" Command="{Binding DialogConfirmCommand}" MinWidth="120">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogDanger}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
