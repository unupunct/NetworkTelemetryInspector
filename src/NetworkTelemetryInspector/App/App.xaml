<Application x:Class="NetworkTelemetryInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the colour theme; App.ApplyTheme swaps it at runtime. -->
                <ResourceDictionary Source="/NetworkTelemetryInspector;component/Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="/NetworkTelemetryInspector;component/Resources/Styles.xaml" />
                <ResourceDictionary Source="/NetworkTelemetryInspector;component/Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
