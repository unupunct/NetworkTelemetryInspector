<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F3F5F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#F1F3F6</Color>
    <Color x:Key="HoverColor">#E8ECF1</Color>
    <Color x:Key="BorderColor">#DCE1E8</Color>
    <Color x:Key="TextColor">#161B22</Color>
    <Color x:Key="Text2Color">#505B69</Color>
    <Color x:Key="MutedColor">#838E9C</Color>
    <Color x:Key="AccentColor">#1A73DB</Color>
    <Color x:Key="CyanColor">#0A93A6</Color>
    <Color x:Key="SuccessColor">#1B9453</Color>
    <Color x:Key="WarningColor">#B87A0B</Color>
    <Color x:Key="DangerColor">#D2353C</Color>
    <Color x:Key="BackgroundClassColor">#4F5FD6</Color>
    <Color x:Key="UnknownColor">#6B7481</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1664C0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F1A73DB" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#1F0A93A6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F1B9453" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#24B87A0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B72A31" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FD2353C" />
    <SolidColorBrush x:Key="BackgroundClassBrush" Color="{StaticResource BackgroundClassColor}" />
    <SolidColorBrush x:Key="BackgroundClassSoftBrush" Color="#1F4F5FD6" />
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource UnknownColor}" />
    <SolidColorBrush x:Key="UnknownSoftBrush" Color="#1F6B7481" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#8C1A1F26" />
    <SolidColorBrush x:Key="GraphDownBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="GraphUpBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="GraphGridBrush" Color="#14000000" />
</ResourceDictionary>
