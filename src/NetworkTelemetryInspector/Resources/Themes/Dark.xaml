<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#0E1014</Color>
    <Color x:Key="SurfaceColor">#151920</Color>
    <Color x:Key="Surface2Color">#1B2028</Color>
    <Color x:Key="HoverColor">#222933</Color>
    <Color x:Key="BorderColor">#262E39</Color>
    <Color x:Key="TextColor">#E6EAF0</Color>
    <Color x:Key="Text2Color">#9DA7B5</Color>
    <Color x:Key="MutedColor">#6A7483</Color>
    <Color x:Key="AccentColor">#3B9EFF</Color>
    <Color x:Key="CyanColor">#2CC4D8</Color>
    <Color x:Key="SuccessColor">#3CC97E</Color>
    <Color x:Key="WarningColor">#EDB44A</Color>
    <Color x:Key="DangerColor">#F05A61</Color>
    <Color x:Key="BackgroundClassColor">#8C9CFF</Color>
    <Color x:Key="UnknownColor">#8A93A1</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5AAEFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#263B9EFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#222CC4D8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#223CC97E" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#24EDB44A" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF7379" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#24F05A61" />
    <SolidColorBrush x:Key="BackgroundClassBrush" Color="{StaticResource BackgroundClassColor}" />
    <SolidColorBrush x:Key="BackgroundClassSoftBrush" Color="#228C9CFF" />
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource UnknownColor}" />
    <SolidColorBrush x:Key="UnknownSoftBrush" Color="#228A93A1" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3080A0D" />
    <SolidColorBrush x:Key="GraphDownBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="GraphUpBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="GraphGridBrush" Color="#1FFFFFFF" />
</ResourceDictionary>
